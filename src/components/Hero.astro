---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import AssetImage from './AssetImage.astro';
const isHome = Astro.url.pathname.replace(/^\/aps-expert/, '') === '/';
---
{isHome ? (
  <section class="aps-home-hero" aria-labelledby="_top">
    <div>
      <p class="aps-home-eyebrow">АПС — профессиональное портфолио</p>
      <h1 id="_top"><span>Александр</span><span>Сибиряков</span><span class="aps-hero-role">Системный аналитик и технический писатель</span></h1>
      <p class="aps-home-intro">Исследование систем, анализ требований, моделирование процессов, разработка технической документации и методик испытаний по ГОСТ 19, 34 и 21, ЕСКД.</p>
      <p class="aps-home-motto">От обследования и формализации требований до испытаний, приёмки и эксплуатации.</p>
      <div class="aps-home-actions">
        <a class="aps-button" href="#real-work">Примеры работ</a>
        <a class="aps-button secondary" href="/aps-expert/wiki/pages/resume/">Скачать резюме</a>
        <a class="aps-home-contact" href="/aps-expert/wiki/pages/contact/">Обсудить задачу →</a>
      </div>
    </div>
    <AssetImage name="portrait" alt="Александр Сибиряков" class="aps-home-portrait" eager lightPortrait/>
  </section>
) : <DefaultHero/>}

