---
import ClientsPartners from './ClientsPartners.astro';
import ToolsTechnologies from './ToolsTechnologies.astro';
const projects = [
  {
    id: 'alpha',
    title: 'АС «АЛЬФА» — комплект документации',
    description: 'Авторский демонстрационный комплект: 16 документов PDF и сопроводительный TXT. Требования, архитектура, данные, API, руководства, испытания и регламенты.',
    detail: 'Таблица состава и навыков аналитика и технического писателя. Архив ZIP: 5,24 МБ.',
    image: '/aps-expert/images/evidence/alpha-project-collage.webp',
    imageAlt: 'АС «АЛЬФА»: буква альфа в окружении элементов разработки',
    imageWidth: 1600,
    imageHeight: 1100,
    href: '/aps-expert/wiki/portfolio/documentation/alpha/',
    action: 'Состав комплекта и навыки',
    approach: 'от требований к испытаниям',
    approachHref: '/aps-expert/blog/analytics/06_requirements_to_tests/',
  },
  {
    id: 'alpha-graphics',
    title: 'АС «АЛЬФА» — графические модели',
    description: '15 иллюстраций: BPMN, UML, ER, прототипы интерфейса, трассировка требований и пример отчёта.',
    detail: 'Подписи, пояснения, демонстрируемые навыки, альбом PDF и исходники PlantUML.',
    image: '/aps-expert/images/graphdemo/02-system-context.svg',
    imageAlt: 'АС «АЛЬФА»: контекстная схема системы и участников',
    imageWidth: 1000,
    imageHeight: 650,
    href: '/aps-expert/wiki/portfolio/analytics/alpha-graphic-models/',
    action: 'Открыть графический кейс',
    approach: 'BPMN, UML и PlantUML',
    approachHref: '/aps-expert/blog/modeling/08_bpmn_uml_plantuml/',
  },
  {
    id: 'alpha-registration',
    title: 'АС «АЛЬФА» — регистрационные досье для подачи в Минрадиопром и Минпромторг + ВНИИР',
    description: 'Демонстрационные регистрационные досье: структура комплекта, описание продукта, исходные сведения, доказательные материалы и контроль их согласованности.',
    detail: 'На странице кейса представлены досье программного продукта и промышленного изделия. Доступны просмотр PDF и скачивание PDF или DOCX с подтверждением.',
    image: '/aps-expert/images/articles/wiki-portfolio-registration-software-registration.webp',
    imageAlt: 'Регистрационные досье программного продукта и промышленного изделия',
    imageWidth: 1279,
    imageHeight: 720,
    href: '/aps-expert/wiki/portfolio/registration/software-registration/',
    action: 'Открыть регистрационный кейс',
    approach: null,
    approachHref: null,
  },
];
---
<div class="aps-home-content">
  <div class="aps-home-proof" aria-label="Основные направления опыта">
    <div><strong>ИТ и НИОКР</strong><span>Программные системы и исследовательские проекты</span></div>
    <div><strong>ГОСТ 19 / 34 / 21</strong><span>Требования, документация и испытания</span></div>
    <div><strong>API и ИИ</strong><span>Интерфейсы, нейросети и виртуальные ассистенты</span></div>
  </div>

  <ClientsPartners />


  <section class="aps-showcase" id="projects" aria-labelledby="aps-projects-title">
    <div class="aps-home-section-heading"><div><p class="aps-home-eyebrow">Технологические разработки · Наносемантика</p><h2 id="aps-projects-title">Проекты</h2></div></div>
    <p class="aps-home-section-lead">Проекты в области искусственного интеллекта, робототехники и речевых технологий.</p>
    <div class="aps-showcase-grid">
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-robot"><span>01 / Робототехника</span><strong>МФТИ</strong></div><div class="aps-showcase-body"><h3>Антропоморфный робот МФТИ</h3><p>Робототехнические разработки и интеллектуальное голосовое взаимодействие.</p><a href="/aps-expert/wiki/projects/robot-mfti/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-dialog"><span>02 / Разговорный ИИ</span><strong>DialogOS</strong></div><div class="aps-showcase-body"><h3>DialogOS (DOS)</h3><p>Платформа для разработки, обучения и тестирования голосовых и текстовых роботов.</p><a href="/aps-expert/wiki/projects/dialogos/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-snow"><span>03 / Цифровые аватары</span><strong>Снежинка</strong></div><div class="aps-showcase-body"><h3>Цифровой аватар «Снежинка»</h3><p>Интерактивный стенд для презентации научных исследований и технологий освоения Арктики.</p><a href="/aps-expert/wiki/projects/snezhinka/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-avatar"><span>04 / Интеллектуальные аватары</span><strong>ИИ</strong></div><div class="aps-showcase-body"><h3>Цифровой аватар «Жириновский»</h3><p>Диалоговый цифровой персонаж с применением технологий искусственного интеллекта.</p><a href="/aps-expert/wiki/projects/zhirinovsky/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-xray"><span>05 / Компьютерное зрение</span><strong>Рентген-аналитика</strong></div><div class="aps-showcase-body"><h3>Анализ рентген-изображений транспорта</h3><p>Анализ рентген-изображений грузовиков и грузов для поддержки пограничного досмотра.</p><a href="/aps-expert/wiki/projects/xray-transport/">Подробнее о проекте →</a></div></article>
      <article class="aps-showcase-card"><div class="aps-showcase-visual aps-uav"><span>06 / Беспилотные системы</span><strong>Автономные платформы</strong></div><div class="aps-showcase-body"><h3>Беспилотные системы</h3><p>Робототехника и управление автономными платформами.</p><a href="/aps-expert/wiki/projects/unmanned/">Подробнее о проекте →</a></div></article>
    </div>
    <p class="aps-showcase-more"><a href="/aps-expert/wiki/pages/projects/">Все проекты →</a></p>
    <p class="aps-home-source">Технологии и проекты разработаны компанией «Наносемантика» и её партнёрами.</p>
  </section>

  <section id="real-work" aria-labelledby="real-work-title">
    <div class="aps-home-section-heading"><div><p class="aps-home-eyebrow">Профессиональное портфолио</p><h2 id="real-work-title">Выполненные работы</h2></div><a href="/aps-expert/wiki/pages/portfolio/">Полное портфолио →</a></div>
    <p class="aps-home-section-lead">Три демонстрационных кейса АС «АЛЬФА»: комплект технической документации, графические модели и регистрационные досье. Каждый кейс открывается на отдельной странице с пояснениями и материалами для просмотра.</p>
    <div class="aps-home-projects">
      {projects.map(project => (
        <article class="aps-home-project" id={project.id}>
          <a href={project.href} aria-label={`Открыть кейс: ${project.title}`}><img src={project.image} alt={project.imageAlt} width={project.imageWidth} height={project.imageHeight} loading="lazy" decoding="async"/></a>
          <div class="aps-home-project-body">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <p class="aps-home-project-detail">{project.detail}</p>
            <div class="aps-home-project-links"><a href={project.href}>{project.action} →</a></div>
            {project.approachHref && <p class="aps-home-source">Подход: <a href={project.approachHref}>{project.approach}</a>.</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <ToolsTechnologies />

  <section aria-labelledby="experience-title">
    <h2 id="experience-title">О специалисте</h2>
    <p><a href="/aps-expert/wiki/pages/about/">Профессиональный профиль, опыт и сведения о его подтверждении →</a></p>
  </section>

  <section aria-labelledby="services-title">
    <p class="aps-home-eyebrow">Задачи, с которыми можно обратиться</p><h2 id="services-title">Чем могу быть полезен</h2>
    <div class="aps-home-services">
      <article><span class="aps-home-number" aria-hidden="true">01</span><h3>Системный аналитик</h3><p>Сбор и согласование требований, сценарии, модели процессов и трассируемость.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">02</span><h3>Технический писатель</h3><p>ТЗ, ПМИ, пояснительные записки, руководства и комплекты документов по ГОСТ.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">03</span><h3>Документация API</h3><p>Описание интерфейсов и взаимодействий, материалы для разработчиков и интеграторов.</p></article>
      <article><span class="aps-home-number" aria-hidden="true">04</span><h3>Аудит и автоматизация</h3><p>Выявление противоречий, проверка комплектности, шаблоны и средства обработки документов.</p></article>
    </div><p><a href="/aps-expert/wiki/pages/services/">Услуги и порядок работы →</a></p>
  </section>

  <section class="aps-home-library" aria-labelledby="library-title">
    <div><p class="aps-home-eyebrow">Отдельный раздел сайта</p><h2 id="library-title">Публикации</h2><p>Практические инструкции по документации, стандартам и инструментам. Авторские комплекты документации показывают подход к решению профессиональных задач.</p><p class="aps-home-source">Демонстрационные материалы подготовлены для портфолио на условных данных, без раскрытия конфиденциальных сведений заказчиков.</p></div>
    <nav aria-label="Статьи и демонстрационные материалы"><a href="/aps-expert/publications/">Открыть публикации →</a><a href="/aps-expert/wiki/portfolio/documentation/technical-documentation/">Посмотреть демонстрационный комплект →</a></nav>
  </section>

  <section class="aps-home-cta" aria-labelledby="contact-title"><div><p class="aps-home-eyebrow">Следующий шаг</p><h2 id="contact-title">Обсудить задачу</h2><p>Для начала достаточно описания системы, назначения документов и имеющихся исходных материалов.</p></div><div class="aps-home-actions"><a class="aps-button" href="/aps-expert/wiki/pages/contact/">Контакты</a><a class="aps-home-contact" href="mailto:wordmaster@textpro-1.ru">Написать по электронной почте →</a></div></section>
</div>

<style>
.aps-showcase{margin:clamp(2rem,5vw,4.5rem) 0}.aps-showcase-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-top:1.5rem}.aps-showcase-card{border:1px solid var(--sl-color-gray-5);border-radius:16px;overflow:hidden;background:var(--sl-color-bg);min-width:0}.aps-showcase-visual{height:170px;display:flex;flex-direction:column;justify-content:space-between;padding:1.25rem;color:#fff;background:#173b5b}.aps-showcase-visual span{font-size:.8rem;letter-spacing:.07em;text-transform:uppercase}.aps-showcase-visual strong{font-size:clamp(1.65rem,3vw,2.7rem);line-height:1.1}.aps-robot{background:linear-gradient(135deg,#0b2638,#236d89)}.aps-dialog{background:linear-gradient(135deg,#152b65,#3979b8)}.aps-snow{background:linear-gradient(135deg,#245e7d,#77a9bb)}.aps-xray{background:linear-gradient(135deg,#0c2639,#137f91)}.aps-uav{background:linear-gradient(135deg,#324a75,#d39c80)}.aps-avatar{background:linear-gradient(135deg,#25334c,#685c88)}.aps-showcase-body{padding:1.2rem}.aps-showcase-body h3{margin:0 0 .6rem;font-size:1.12rem}.aps-showcase-body p{margin:0 0 .65rem;line-height:1.55}.aps-showcase-more{text-align:right;margin-top:1.25rem;font-weight:700}@media(max-width:640px){.aps-showcase-grid{grid-template-columns:1fr}.aps-showcase-visual{height:135px}}
.aps-robot{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/robot-mfti.webp');background-position:center;background-size:cover}.aps-dialog{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/dialogos.webp');background-position:center;background-size:cover}.aps-snow{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/snezhinka.webp');background-position:center;background-size:cover}.aps-avatar{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/zhirinovsky.webp');background-position:center;background-size:cover}.aps-xray{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/xray-transport-truck.webp');background-position:center;background-size:cover}.aps-uav{background-image:linear-gradient(0deg,rgba(4,15,31,.6),rgba(4,15,31,.02) 65%),url('/aps-expert/images/projects/unmanned.webp');background-position:center;background-size:cover}.aps-showcase-visual.aps-xray{background-color:#031329;background-size:cover;background-position:left center;background-repeat:no-repeat;position:relative;justify-content:flex-start}.aps-xray span{background:rgba(3,19,41,.85);align-self:flex-start;padding:.15rem .4rem}.aps-xray strong{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap}</style>
