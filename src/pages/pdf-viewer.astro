---
import DownloadConfirmation from '../components/DownloadConfirmation.astro';
import 'pdfjs-dist/web/pdf_viewer.css';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, follow" />
    <title>Просмотр PDF — Сайт АПС</title>
    <link rel="icon" href="/alsibir-expert/favicon.svg" />
  </head>
  <body>
    <div class="reader">
      <header class="reader-header">
        <div class="reader-title-row">
          <a id="return-link" href="/alsibir-expert/wiki/pages/portfolio/">Вернуться к материалу</a>
          <h1 id="document-title">Просмотр PDF</h1>
          <a id="download-pdf" class="reader-button" download hidden>Скачать PDF</a>
        </div>
        <nav class="reader-toolbar" aria-label="Управление просмотром PDF">
          <div class="reader-group">
            <button id="previous-page" type="button" disabled aria-label="Предыдущая страница">Назад</button>
            <label for="page-number">Страница</label>
            <input id="page-number" type="number" inputmode="numeric" min="1" value="1" disabled />
            <span id="page-count">из —</span>
            <button id="next-page" type="button" disabled aria-label="Следующая страница">Вперёд</button>
          </div>
          <div class="reader-group">
            <button id="zoom-out" type="button" disabled aria-label="Уменьшить масштаб">−</button>
            <output id="zoom-level" aria-label="Масштаб">—</output>
            <button id="zoom-in" type="button" disabled aria-label="Увеличить масштаб">+</button>
            <button id="fit-width" type="button" disabled>По ширине</button>
          </div>
        </nav>
      </header>
      <p id="reader-status" role="status" aria-live="polite">Загрузка документа…</p>
      <div id="reader-error" role="alert" hidden>
        <p id="reader-error-text"></p>
        <button type="button" id="retry">Повторить</button>
        <p>Можно вернуться к материалу или скачать PDF отдельной кнопкой с подтверждением.</p>
      </div>
      <noscript><p>Для просмотра документа необходимо включить JavaScript. Скачивание PDF доступно на странице исходного материала.</p></noscript>
      <main class="reader-document" aria-label="Страницы документа">
        <div id="viewerContainer" tabindex="0">
          <div id="viewer" class="pdfViewer"></div>
        </div>
      </main>
    </div>
    <DownloadConfirmation />
    <script>
      import '../scripts/pdf-viewer';
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: light dark; --aps-surface:#fff; --aps-ink:#182b40; --aps-line:#ced8e3; --aps-accent:#126d9b; --aps-accent-soft:#e9f3fa; --aps-button-ink:#fff; --reader-bg:#dce3eb; }
  @media (prefers-color-scheme:dark) { :root { --aps-surface:#152130; --aps-ink:#e5edf5; --aps-line:#405166; --aps-accent:#77c8ef; --aps-accent-soft:#253e51; --aps-button-ink:#10212f; --reader-bg:#0b131e; } }
  * { box-sizing:border-box; }
  body { margin:0; font:15px/1.45 system-ui,sans-serif; background:var(--reader-bg); color:var(--aps-ink); }
  .reader { display:flex; flex-direction:column; height:100vh; height:100dvh; }
  .reader-header { flex:none; padding:8px max(12px,env(safe-area-inset-left)) 8px max(12px,env(safe-area-inset-right)); background:var(--aps-surface); border-bottom:1px solid var(--aps-line); }
  .reader-title-row { display:flex; align-items:center; gap:12px; min-width:0; }
  .reader-title-row h1 { flex:1; font-size:15px; font-weight:600; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  a { color:var(--aps-accent); text-underline-offset:3px; }
  .reader-title-row > a:first-child { font-size:13px; }
  button,.reader-button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:6px 12px; border:1px solid var(--aps-line); border-radius:6px; background:var(--aps-surface); color:var(--aps-ink); font:inherit; text-decoration:none; cursor:pointer; touch-action:manipulation; }
  button:disabled { opacity:.45; cursor:default; }
  button:focus-visible,a:focus-visible,input:focus-visible,#viewerContainer:focus-visible { outline:3px solid var(--aps-accent); outline-offset:2px; }
  .reader-toolbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px 16px; margin-top:6px; }
  .reader-group { display:flex; align-items:center; gap:8px; }
  #page-number { width:64px; min-height:44px; padding:6px; border:1px solid var(--aps-line); border-radius:6px; background:var(--aps-surface); color:var(--aps-ink); font:inherit; text-align:center; }
  #zoom-level { min-width:48px; text-align:center; }
  #reader-status { flex:none; margin:0; padding:6px 12px; font-size:13px; background:var(--aps-surface); }
  #reader-error { padding:12px; background:var(--aps-surface); }
  #reader-error p { margin:6px 0 12px; }
  .reader-document { position:relative; flex:1; min-height:0; }
  #viewerContainer { position:absolute; inset:0; overflow:auto; overscroll-behavior:contain; }
  .pdfViewer { --page-margin:8px auto; --page-border:0; }
  [hidden] { display:none !important; }
  @media (max-width:600px) {
    .reader-title-row { flex-wrap:wrap; gap:4px 10px; }
    .reader-title-row h1 { flex-basis:100%; order:3; font-size:13px; }
    .reader-title-row > a:first-child { flex:1; }
    .reader-toolbar { gap:4px; }
    .reader-group { gap:5px; }
    button,.reader-button { padding:5px 9px; font-size:13px; }
    #page-number { width:50px; }
    .reader-group label,#page-count { font-size:13px; }
  }
</style>
