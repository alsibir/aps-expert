{
  "name": "alsibir-expert",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node node_modules/astro/bin/astro.mjs dev",
    "start": "node node_modules/astro/bin/astro.mjs dev",
    "build": "node scripts/generate-publications.mjs && node node_modules/astro/bin/astro.mjs build && node scripts/postbuild.mjs",
    "preview": "node node_modules/astro/bin/astro.mjs preview",
    "astro": "node node_modules/astro/bin/astro.mjs",
    "serve:static": "python3 scripts/preview-static.py",
    "diagrams:render": "node scripts/render-diagrams.mjs",
    "graphdemo:render": "node scripts/render-graphdemo.mjs",
    "test:pdf": "node --test scripts/test-pdf-links.mjs && python3 scripts/audit-pdf-viewer.py",
    "audit:all": "npm run build && python3 scripts/audit.py && python3 scripts/audit-anchors.py && npm run test:pdf && python3 scripts/audit-seo.py"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.2.10",
    "pdfjs-dist": "6.5.438",
    "sharp": "^0.35.3",
    "starlight-blog": "^0.30.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0"
  }
}
